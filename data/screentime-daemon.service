[Unit]
Description=ScreenTime application usage tracking daemon
Documentation=https://github.com/screentime/screentime
# Only makes sense once there's a graphical session to read window focus from.
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/screentime-daemon
Restart=on-failure
RestartSec=3
# The daemon reads a lot of small env vars (WAYLAND_DISPLAY, DISPLAY,
# XDG_SESSION_TYPE, XDG_CURRENT_DESKTOP, SWAYSOCK, HYPRLAND_INSTANCE_SIGNATURE,
# XDG_SESSION_ID) from the user's graphical session environment. On most
# modern setups systemd --user already imports these via
# `systemctl --user import-environment` in the session startup, or the
# service inherits them from being started as part of graphical-session.target.
# If autodetection reports "unsupported"/"disabled" in Settings, see the
# README section "Environment variables not reaching the systemd service".

# Keep resource usage negligible: this competes with nothing, but limits
# guard against any unexpected runaway behavior.
MemoryHigh=64M
CPUWeight=10

[Install]
WantedBy=graphical-session.target
