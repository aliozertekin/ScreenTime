# pacman install script for screentime.
#
# A package upgrade replaces the Python files on disk but does NOT restart a
# per-user systemd service that is already running, so after `pacman -U` the
# daemon kept executing the OLD code until the next login/reboot (new fixes
# appeared not to work). Restart it for every logged-in user.

post_upgrade() {
    # Nothing to restart without systemd's login manager / service manager.
    command -v loginctl >/dev/null 2>&1 || return 0
    command -v systemctl >/dev/null 2>&1 || return 0

    # An unusable loginctl (no bus, chroot, container) or an empty user list
    # means there is no session to restart: succeed without touching systemctl.
    local users
    users=$(loginctl list-users --no-legend 2>/dev/null) || return 0
    [ -n "$users" ] || return 0

    local uid user _rest restarted=0
    while read -r uid user _rest; do
        # Only well-formed "<numeric uid> <name> ..." rows are real sessions.
        case "$uid" in ''|*[!0-9]*) continue ;; esac
        [ -n "$user" ] || continue
        # try-restart: only acts if the service is currently active, so users
        # who stopped tracking on purpose are left alone. Never fail the upgrade.
        timeout 20 systemctl --user --machine="${user}@.host" try-restart screentime-daemon.service \
            >/dev/null 2>&1 || true
        restarted=1
    done <<< "$users"

    [ "$restarted" -eq 0 ] || echo ":: screentime: running daemons were restarted to load the new version."
    return 0
}
