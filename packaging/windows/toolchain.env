# Pins for the Windows build toolchain. Edit here, not in the scripts.
# Changing this file or the Containerfile rebuilds the build image.
# (Sourced by bash; keep it plain KEY=VALUE.)
UBUNTU_IMAGE=docker.io/library/ubuntu:24.04
INNO_VERSION=6.4.3
INNO_URL=https://files.jrsoftware.org/is/6/innosetup-6.4.3.exe
# ucrt64 is MSYS2's recommended 64-bit environment; it needs the Universal C Runtime that ships with Windows 10/11.
MSYS2_ENV=ucrt64
MSYS2_REPO_URLS="https://repo.msys2.org/mingw/ucrt64 https://mirror.msys2.org/mingw/ucrt64"
MSYS2_PREFIX=mingw-w64-ucrt-x86_64-
