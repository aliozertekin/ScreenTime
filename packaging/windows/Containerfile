# Build image for the Windows packaging pipeline. Everything Windows-related runs in here, never on the host.
# Wine is used for exactly two things: running Inno Setup's compiler and smoke-testing the bundle.
ARG UBUNTU_IMAGE=docker.io/library/ubuntu:24.04
FROM ${UBUNTU_IMAGE}
ENV DEBIAN_FRONTEND=noninteractive LANG=C.UTF-8
RUN dpkg --add-architecture i386 \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates curl python3 python3-pefile zstd tar xz-utils file \
      libglib2.0-bin librsvg2-bin imagemagick \
      xvfb xauth procps \
      wine wine64 wine32:i386 libwine libwine:i386 fonts-wine \
 && rm -rf /var/lib/apt/lists/*
# 32-bit Inno Setup compiler needs the i386 Wine; HOME and WINEPREFIX are redirected into the mounted cache at run time.
ENV WINEDEBUG=-all WINEARCH=win64 WINEDLLOVERRIDES="mscoree,mshtml="
WORKDIR /work
